<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Library host for the vendored ngrep sources. This is not upstream's executable
    project: Aim publishes one Native AOT binary per RID and calls this code in-process.
    Upstream's Satori GC SDK and per-ISA IlcInstructionSet builds are intentionally absent.
    SIMD paths stay in the sources and light up through runtime IsSupported checks.
    See UPSTREAM.md.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Ngrep</AssemblyName>
    <RootNamespace>Ngrep</RootNamespace>
    <Version>0.20.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <Description>Vendored ngrep search library (huiyuanai709/ngrep v0.20.0). SIMD scanners included.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aim" />
    <InternalsVisibleTo Include="Aim.Tests" />
    <InternalsVisibleTo Include="Ngrep.Tests" />
    <InternalsVisibleTo Include="Ngrep.Bench" />
  </ItemGroup>
</Project>
